# ───────── OCD Live : variables d'environnement ─────────
# Sans DATABASE_URL, le site tourne en « mode démo » (données en mémoire, planning pré-rempli, mot de passe Régie : regie2026).

# Base de données Postgres (Supabase : Project Settings → Database → Connection string → « Transaction pooler », port 6543)
DATABASE_URL=

# Mot de passe de la Régie (/regie). Obligatoire dès que DATABASE_URL est défini.
ADMIN_PASSWORD=
# Optionnel : clé de signature des sessions (sinon dérivée du mot de passe)
ADMIN_SECRET=

# Notifications instantanées sur Telegram (gratuit) : voir README
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifications par e-mail via Resend (resend.com, gratuit jusqu'à 3 000 mails/mois)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Infos publiques affichées sur le site
NEXT_PUBLIC_SITE_URL=https://ocd-live.vercel.app
NEXT_PUBLIC_OCD_WHATSAPP=          # ex : 22890000000 (sans + ni espaces)
NEXT_PUBLIC_PAY_FLOOZ=             # numéro Flooz affiché après réservation
NEXT_PUBLIC_PAY_MIXX=              # numéro Mixx by Yas affiché après réservation
NEXT_PUBLIC_STUDIO_ADDRESS=        # adresse du studio à Lomé
NEXT_PUBLIC_FOUNDER_NAME=Boovan
NEXT_PUBLIC_LIVE_ACCOUNT=House of Challenge
